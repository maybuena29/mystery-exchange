# Optional: Server-side secret salt for additional token hashing defense-in-depth.
# Set this in Netlify Dashboard -> Site configuration -> Environment variables (scope: Functions).
# If omitted, standard SHA-256 over high-entropy 256-bit random tokens is used.
TOKEN_HASH_PEPPER=

# Optional: Rate limit window & max requests per IP for join/create endpoints.
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_MS=60000
